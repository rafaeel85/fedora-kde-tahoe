#!/usr/bin/env python3
# Keep Konsole's toolbars hidden (Terminal.app look): clears the "visible" byte of
# mainToolBar/sessionToolbar in the QMainWindow state that Konsole saves on close.
import base64, re, pathlib
p = pathlib.Path.home() / '.local/state/konsolestaterc'
if p.exists():
    s = p.read_text()
    changed = False
    def fix(m):
        global changed
        b = bytearray(base64.b64decode(m.group(2)))
        for name in ('mainToolBar', 'sessionToolbar'):
            enc = name.encode('utf-16-be')
            i = b.find(enc)
            if i >= 0 and b[i + len(enc)] == 1:
                b[i + len(enc)] = 0
                changed = True
        return m.group(1) + base64.b64encode(bytes(b)).decode()
    s2 = re.sub(r'^(State=)(.*)$', fix, s, flags=re.M)
    if changed:
        p.write_text(s2)
