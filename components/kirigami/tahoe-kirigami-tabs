#!/bin/sh
# Re-apply the macOS Tahoe segmented-tab look to Kirigami (System Settings etc.).
# The two QML files are owned by kf6-kirigami, so a package update restores the originals;
# rerun it after kf6-kirigami updates (tahoe-health-check --full reminds you).
set -e
SRC=@HOME@/.local/src/kirigami-tahoe/patches
DST=@QTQML@/org/kde/kirigami/controls
BAK=@HOME@/.local/state/fedora-kde-tahoe/kirigami-controls-original
for f in NavigationTabButton.qml NavigationTabBar.qml; do
    if ! grep -q "Local macOS Tahoe patch" "$DST/$f"; then
        mkdir -p "$BAK"; cp "$DST/$f" "$BAK/$f"   # keep the pristine version of the current package
    fi
    install -m 644 "$SRC/$f" "$DST/$f"
done
echo "Tahoe tabs applied to $DST"
